{
  "name": "@executor-js/host-cloudflare",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "build": "vite build && node scripts/assert-shell-asset.mjs",
    "deploy": "vite build && node scripts/assert-shell-asset.mjs && wrangler deploy",
    "deploy:alchemy": "bun run build && bun run --cwd ../host-cloudflare-alchemy deploy",
    "deploy:alchemy:adopt": "bun run build && bun run --cwd ../host-cloudflare-alchemy deploy:adopt",
    "deploy:alchemy:validation": "bun run build && bun run --cwd ../host-cloudflare-alchemy deploy:validation",
    "plan:alchemy": "bun run build && bun run --cwd ../host-cloudflare-alchemy plan",
    "plan:alchemy:adopt": "bun run build && bun run --cwd ../host-cloudflare-alchemy plan:adopt",
    "plan:alchemy:validation": "bun run build && bun run --cwd ../host-cloudflare-alchemy plan:validation",
    "dev": "wrangler dev",
    "dev:web": "vite dev",
    "typecheck": "tsgo --noEmit",
    "cf-typegen": "wrangler types",
    "deploy:setup": "bash scripts/deploy.sh",
    "vendor-wasm": "bun run scripts/vendor-quickjs-wasm.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "routes:gen": "bun scripts/gen-routes.ts"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@executor-js/api": "workspace:*",
    "@executor-js/app": "workspace:*",
    "@executor-js/cloudflare": "workspace:*",
    "@executor-js/execution": "workspace:*",
    "@executor-js/fumadb": "workspace:*",
    "@executor-js/host-mcp": "workspace:*",
    "@executor-js/mcp-apps-shell": "workspace:*",
    "@executor-js/plugin-encrypted-secrets": "workspace:*",
    "@executor-js/plugin-graphql": "workspace:*",
    "@executor-js/plugin-mcp": "workspace:*",
    "@executor-js/plugin-openapi": "workspace:*",
    "@executor-js/plugin-provider-service-split": "workspace:*",
    "@executor-js/plugin-toolkits": "workspace:*",
    "@executor-js/react": "workspace:*",
    "@executor-js/runtime-dynamic-worker": "workspace:*",
    "@executor-js/runtime-quickjs": "workspace:*",
    "@executor-js/sdk": "workspace:*",
    "@jitl/quickjs-wasmfile-release-sync": "catalog:",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-router": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "jose": "^5.9.6",
    "quickjs-emscripten-core": "0.31.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "@effect/vitest": "catalog:",
    "@executor-js/vite-plugin": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "^1.167.12",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsonc-parser": "^3.3.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.95.0"
  }
}
