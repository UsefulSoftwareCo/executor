---
export const prerender = true;
import RailLayout from "../../layouts/RailLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    // Frontmatter dates are bare YYYY-MM-DD (UTC midnight); format in UTC so
    // the displayed day matches what the author wrote regardless of timezone.
    timeZone: "UTC",
  });
---

<RailLayout title="Blog — Executor" description="Latest news and updates from Executor." current="blog">
  <article class="doc">
    <header class="doc__intro">
      <h1 class="doc__title">Writing</h1>
      <p class="doc__lede">Notes from building Executor.</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="text-[15px] text-ink-3">No posts yet. Check back soon.</p>
      ) : (
        <ul class="doc__posts">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="doc__post">
                <span class="doc__post-date">{fmt(post.data.date)}</span>
                <span class="doc__post-title">{post.data.title}</span>
                <span class="doc__post-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </article>
</RailLayout>
