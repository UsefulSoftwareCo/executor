---
import { Code } from "astro:components";
import SourceFile from "./source-file.astro";
import { appFiles } from "../content/app-structure";

const rootFiles = appFiles.filter((file) => !file.path.includes("/") && file.path !== "package.json");
const folders = [
  { name: "skills / brief", files: appFiles.filter((file) => file.path.startsWith("skills/")) },
  { name: "ui", files: appFiles.filter((file) => file.path.startsWith("ui/")) },
];
---

<app-source-viewer class="doc__fig--wide @container mt-7 block max-w-225">
  <div class="overflow-hidden rounded-[10px] border border-[#e5e5e5] bg-white shadow-[0_2px_6px_#00000003]">
    <div class="grid @min-[640px]:grid-cols-[200px_minmax(0,1fr)]">
      <nav aria-label="App files" class="hidden border-r border-[#e8e8e8] bg-[#fafafa] @min-[640px]:block">
        <div class="flex h-12 items-center gap-2.5 border-b border-[#e8e8e8] px-4">
          <svg aria-hidden="true" class="size-4 text-[#888]" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M2.5 5a1 1 0 0 1 1-1h4l2 2h7a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1Z" /></svg>
          <span class="font-mono text-[12px] font-medium text-[#444]">daily-brief</span>
        </div>
        <div class="px-2.5 py-3">
          <ul>{rootFiles.map((file) => <SourceFile file={file} />)}</ul>
          {folders.map((folder) => (
            <details open class="group/folder">
              <summary class="flex min-h-9 cursor-pointer list-none items-center gap-2 rounded-[5px] px-2 text-[12px] text-[#777] hover:bg-[#f0f0f0] focus-visible:outline-2 focus-visible:outline-[#888] [&::-webkit-details-marker]:hidden">
                <svg aria-hidden="true" class="size-3 shrink-0 -rotate-90 transition-transform group-open/folder:rotate-0" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2"><path d="m3 4.5 3 3 3-3" /></svg>
                <svg aria-hidden="true" class="size-3.5 shrink-0 text-[#999]" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2.5 5a1 1 0 0 1 1-1h4l2 2h7a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1Z" /></svg>
                <span class="font-mono">{folder.name}</span>
              </summary>
              <ul class="ml-3.5 border-l border-[#e5e5e5] pl-2">{folder.files.map((file) => <SourceFile file={file} />)}</ul>
            </details>
          ))}
          <ul>{appFiles.filter((file) => file.path === "package.json").map((file) => <SourceFile file={file} />)}</ul>
        </div>
      </nav>

      <div class="min-w-0">
        <div class="flex min-h-12 items-center gap-3 border-b border-[#e8e8e8] bg-[#fafafa] px-4 @min-[640px]:hidden">
          <label for="app-source-file" class="shrink-0 text-[12px] text-[#888]">Open file</label>
          <select id="app-source-file" data-file-select aria-label="Open app file" class="min-w-0 flex-1 cursor-pointer rounded border border-[#e2e2e2] bg-white px-2 py-1.5 font-mono text-[12px] text-[#333] focus-visible:outline-2 focus-visible:outline-[#888]">
            {appFiles.map((file) => <option value={file.path}>{file.path}</option>)}
          </select>
        </div>

        {appFiles.map((file, index) => (
          <section data-file-panel={file.path} aria-label={file.path} hidden={index !== 0}>
            <div class="flex h-12 items-center gap-2.5 border-b border-[#e8e8e8] px-5">
              <svg aria-hidden="true" class="size-3.5 shrink-0 text-[#aaa]" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M5 2.5h6l4 4v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-13a1 1 0 0 1 1-1ZM11 2.5v4h4" /></svg>
              <span class="truncate font-mono text-[12px] text-[#555]">{file.path}</span>
              <span class="ml-auto shrink-0 text-[11px] text-[#aaa]">{file.source.split("\n").length} lines</span>
            </div>
            <div tabindex="0" aria-label={`${file.path} source`} class="h-[330px] overflow-auto overscroll-contain outline-offset-[-2px] focus-visible:outline-2 focus-visible:outline-[#aaa] @min-[640px]:h-[376px]">
              <div class="flex min-w-max py-5 pr-5 font-mono text-[12px] leading-[22px] @min-[760px]:text-[13px]">
                <div aria-hidden="true" class="sticky left-0 shrink-0 select-none bg-white pr-4 pl-4 text-right text-[#b7b7b7] @min-[640px]:pr-5 @min-[640px]:pl-5">
                  {file.source.split("\n").map((_, line) => <div>{line + 1}</div>)}
                </div>
                <div class="[&_pre]:overflow-visible! [&_pre]:bg-transparent! [&_pre]:font-mono [&_pre]:text-[inherit] [&_pre]:leading-[22px] [&_code]:font-mono">
                  <Code code={file.source} lang={file.language} theme="github-light" />
                </div>
              </div>
            </div>
            <div class="min-h-24 border-t border-[#e8e8e8] bg-[#fdfdfd] px-5 py-4 @min-[640px]:h-24">
              <h3 class="text-[13px] font-medium text-[#333]">{file.label}</h3>
              <p class="mt-1 max-w-[60ch] text-[12px] leading-[1.65] text-[#888]">{file.description}</p>
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
  <p class="mt-3.5 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-[12px] leading-relaxed text-[#999]">
    <span>One app. Ordinary files.</span>
    <span>Choose a file to look inside.</span>
  </p>
</app-source-viewer>

<script>
  class AppSourceViewer extends HTMLElement {
    private events: AbortController | undefined;

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-open-file]"));
      const panels = Array.from(this.querySelectorAll<HTMLElement>("[data-file-panel]"));
      const select = this.querySelector<HTMLSelectElement>("[data-file-select]");

      const openFile = (path: string) => {
        const selected = panels.find((panel) => panel.dataset.filePanel === path);
        if (!selected) return;
        for (const panel of panels) panel.hidden = panel !== selected;
        for (const button of buttons) {
          button.setAttribute("aria-pressed", String(button.dataset.openFile === path));
        }
        if (select) select.value = path;
      };

      for (const button of buttons) {
        button.addEventListener("click", () => {
          const path = button.dataset.openFile;
          if (path) openFile(path);
        }, { signal: this.events.signal });
      }
      select?.addEventListener("change", () => openFile(select.value), { signal: this.events.signal });
    }

    disconnectedCallback() {
      this.events?.abort();
    }
  }

  customElements.define("app-source-viewer", AppSourceViewer);
</script>
