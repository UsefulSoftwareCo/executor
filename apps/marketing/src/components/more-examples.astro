---
import stripe from "../assets/logos/stripe.svg?url";
import notion from "../assets/logos/notion.svg?url";
import slack from "../assets/logos/slack.svg?url";
import sentry from "../assets/logos/sentry.svg?url";
import linear from "../assets/logos/linear.svg?url";
import posthog from "../assets/logos/posthog.svg?url";
import github from "../assets/logos/github.svg?url";
import { moreExamples } from "../content/site-copy";
import { logoClass } from "../lib/logos";

const logos: Record<string, string> = { stripe, notion, slack, sentry, linear, posthog, github };
---

<div class="doc__fig--wide @container mt-5 max-w-225">
<ul class="grid gap-px overflow-hidden rounded-[10px] border border-tone-90 bg-tone-90 @min-[620px]:grid-cols-2">
  {moreExamples.map((example, index) => (
    <li class="reveal flex flex-col bg-tone-100 px-5 py-5 @min-[760px]:px-6" style={`transition-delay:${index * 60}ms`}>
      <div class="mb-3.5 flex items-center gap-2" aria-hidden="true">
        {example.logos.map((key) => (
          <img src={logos[key]} alt="" width="16" height="16" class:list={["size-4 object-contain", logoClass(key)]} />
        ))}
      </div>
      <p class="text-[15px] leading-[1.5] tracking-[-0.01em] text-tone-20">“{example.prompt}”</p>
      <p class="mt-2 text-[12.5px] leading-[1.6] text-tone-53">{example.result}</p>
      <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
        {example.pieces.map((piece) => (
          <span class="rounded-[5px] border border-tone-89 px-2 py-0.5 font-mono text-[10.5px] text-tone-47">{piece}</span>
        ))}
      </div>
    </li>
  ))}
</ul>
</div>
