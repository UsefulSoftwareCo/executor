---
import RailLayout from "../../layouts/RailLayout.astro";
import { tagline, introduction } from "../../content/site-copy";
import { heroVariants, type HeroVariant } from "../../content/hero-experiment";
import DocBody from "./doc-body.astro";

interface Props { variant?: HeroVariant }
const { variant = heroVariants[0] } = Astro.props;
const GH = "https://github.com/UsefulSoftwareCo/executor";
---

<RailLayout
  title={`Executor — ${tagline}`}
  description={introduction}
>
  <DocBody gh={GH} variant={variant} />
</RailLayout>


<script>
  // Copy buttons. Use the async Clipboard API in secure contexts and fall back
  // to a hidden textarea + execCommand otherwise, so copy (and the copied-state
  // animation) also works over plain HTTP, e.g. a LAN / tailnet dev host where
  // navigator.clipboard is undefined.
  const copyToClipboard = async (text: string): Promise<boolean> => {
    if (window.isSecureContext && navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {}
    }
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly", "");
    ta.className = "fixed top-0 left-0 opacity-0";
    document.body.appendChild(ta);
    ta.select();
    let ok = false;
    try {
      ok = document.execCommand("copy");
    } catch {}
    document.body.removeChild(ta);
    return ok;
  };

  for (const btn of document.querySelectorAll<HTMLButtonElement>(
    "button[data-copy]",
  )) {
    let timer: ReturnType<typeof setTimeout> | null = null;
    btn.addEventListener("click", async () => {
      const ok = await copyToClipboard(btn.dataset.copy ?? "");
      btn.dataset.copied = ok ? "true" : "false";
      const event = btn.dataset.event;
      if (ok && event) {
        window.dispatchEvent(
          new CustomEvent("analytics:capture", {
            detail: { event, properties: { surface: "marketing_hero" } },
          }),
        );
      }
      if (timer) clearTimeout(timer);
      timer = setTimeout(() => {
        delete btn.dataset.copied;
      }, 1500);
    });
  }
</script>

<script>
  // ── Scroll reveals ─────────────────────────────────────────────────
  // Sections fade + rise into view as they enter the viewport. The
  // hidden initial state is applied by JS (`.reveal-init`) so no-JS
  // visitors and reduced-motion users always see fully-rendered content.
  const reveals = Array.from(
    document.querySelectorAll<HTMLElement>(".reveal"),
  );
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  if (reveals.length > 0 && !prefersReduced && "IntersectionObserver" in window) {
    for (const el of reveals) el.classList.add("reveal-init");
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
    );
    for (const el of reveals) io.observe(el);
  }
</script>
