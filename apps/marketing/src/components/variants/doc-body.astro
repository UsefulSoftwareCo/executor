<script>
  import { assetUrl, fetchNewestRelease } from "../../lib/desktop-release";

  // Point each download at the newest published release. Buttons cloned into
  // "Other platforms" keep data-asset, so they are updated too.
  void (async () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-download]")) {
      const { releasesApi, tagPrefix, stableOnly } = root.dataset;
      if (!releasesApi || !tagPrefix) continue;
      const release = await fetchNewestRelease(releasesApi, {
        tagPrefix,
        stableOnly: stableOnly === "true",
      }).catch(() => null);
      if (!release) continue;
      for (const link of root.querySelectorAll<HTMLAnchorElement>("a[data-asset]")) {
        const url = assetUrl(release, link.dataset.asset ?? "");
        if (url) link.href = url;
      }
    }
  })();

  // Show one download button for the visitor's OS and tuck the rest behind
  // "Other platforms". Without JS or on an unknown OS, all platforms stay visible.
  type DownloadOs = "mac-arm64" | "mac-x64" | "win-x64" | "linux-x64" | "linux-arm64";
  type UserAgentData = {
    readonly platform: string;
    readonly getHighEntropyValues?: (
      hints: ReadonlyArray<string>,
    ) => Promise<{ readonly architecture?: string }>;
  };
  const detectOs = async (): Promise<DownloadOs | null> => {
    const uad = (navigator as Navigator & { readonly userAgentData?: UserAgentData }).userAgentData;
    const platform = (uad?.platform ?? navigator.platform ?? "").toLowerCase();
    const ua = navigator.userAgent.toLowerCase();
    if (platform.includes("win") || ua.includes("windows")) return "win-x64";
    if (platform.includes("linux") || ua.includes("linux")) {
      if (uad?.getHighEntropyValues) {
        try {
          const h = await uad.getHighEntropyValues(["architecture"]);
          if (h.architecture === "arm") return "linux-arm64";
        } catch {}
      }
      return ua.includes("aarch64") ? "linux-arm64" : "linux-x64";
    }
    if (platform.includes("mac") || ua.includes("mac")) {
      if (uad?.getHighEntropyValues) {
        try {
          const h = await uad.getHighEntropyValues(["architecture"]);
          if (h.architecture === "x86") return "mac-x64";
        } catch {}
      }
      return "mac-arm64";
    }
    return null;
  };
  void (async () => {
    const detected = await detectOs();
    if (!detected) return;
    for (const root of document.querySelectorAll<HTMLElement>("[data-download]")) {
      const other = root.querySelector<HTMLElement>("[data-download-other]");
      const list = root.querySelector<HTMLElement>("[data-download-other-list]");
      if (!other || !list) continue;
      for (const btn of root.querySelectorAll<HTMLAnchorElement>("a[data-os]")) {
        if (btn.dataset.os === detected) continue;
        btn.classList.add("hidden");
        btn.toggleAttribute("inert", true);
        const clone = btn.cloneNode(true) as HTMLAnchorElement;
        clone.removeAttribute("inert");
        clone.className = "";
        list.appendChild(clone);
      }
      other.classList.remove("hidden");
    }
  })();
</script>
