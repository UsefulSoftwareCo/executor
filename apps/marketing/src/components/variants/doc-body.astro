        <span class="doc__way-d text-[14px] leading-[1.55] [color:var(--color-ink-2)] flex-1">Your apps and accounts, on your computer.</span>
        <span class="doc__way-a flex flex-wrap items-center gap-[0.5rem_0.75rem] mt-[0.6rem]"><span class="doc__dl [&>.hidden]:hidden inline-flex flex-wrap items-center gap-[0.5rem_0.75rem] max-[719.98px]:[.doc\_\_actions_>_&]:w-full max-[719.98px]:[.doc\_\_actions_>_&]:justify-center max-[719.98px]:[.doc\_\_actions_>_&]:text-center max-[719.98px]:flex max-[719.98px]:flex-col max-[719.98px]:items-stretch max-[719.98px]:[&_>_a]:w-full max-[719.98px]:[&_>_a]:justify-center max-[719.98px]:[.doc\_\_way-a_&]:w-full" data-download data-releases-api={desktopDownloads.releasesApi} data-tag-prefix={desktopDownloads.tagPrefix} data-stable-only={String(desktopDownloads.stableOnly)}>
            {platforms.map((target) => (
              <a data-os={`${target.desktopOs}-${target.arch}`} data-asset={desktopAssetSuffix(target)} href={desktopDownloads.releasesPage} class="btn-secondary inline-flex items-center gap-[0.4rem] bg-surface text-ink border border-rule rounded-[8px] py-[0.7rem] px-[1.25rem] [font-family:inherit] font-medium text-[14.5px] tracking-[-0.005em] cursor-pointer [transition:background_0.15s_ease,_border-color_0.15s_ease] hover:[background:var(--color-surface-2)] hover:[border-color:var(--color-ink-3)] [.doc\_\_way-a_&]:text-[13.5px] [.doc\_\_way-a_&]:py-[0.55rem] [.doc\_\_way-a_&]:px-[0.95rem] [.doc\_\_section_a&]:no-underline max-[719.98px]:[.doc\_\_way-a_&]:w-full max-[719.98px]:[.doc\_\_way-a_&]:justify-center max-[719.98px]:[.doc\_\_way-a_&]:text-center [.pricing\_\_card_>_&]:self-start [.pricing\_\_card_>_&]:mb-[1.4rem]">
                {target.platform === "darwin" ? (target.arch === "arm64" ? "Download for Mac" : "Download for Mac (Intel)") : target.platform === "win32" ? "Download for Windows" : `Download for Linux (${target.arch === "arm64" ? "ARM64" : "x64"})`}
              </a>
            ))}
