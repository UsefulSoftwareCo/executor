---
// Keep the homepage compact; open the complete quotes in a focused reading view.
import { testimonials } from "../../content/testimonials";
import TestimonialCard from "./testimonial-card.astro";

// Deal the list into rows in turn so long and short posts mix.
const ROWS = 3;
const rows = Array.from({ length: ROWS }, (_, row) =>
  testimonials.filter((_, index) => index % ROWS === row),
);

// "Add yours" opens X's composer with a draft the reader can edit or delete.
const composeUrl = `https://x.com/intent/post?text=${encodeURIComponent(
  "I've been using @executorsh to ",
)}`;
---

<div class="testi relative mt-6" data-testimonials>
  <div class="testi__marquee grid gap-3 [mask-image:linear-gradient(90deg,transparent,#000_6%,#000_94%,transparent)] motion-reduce:[mask-image:none] max-[719.98px]:[mask-image:linear-gradient(90deg,transparent,#000_10%,#000_90%,transparent)]">
    {
      rows.map((row, r) => (
        <div class="testi__row flex gap-3 overflow-hidden [--testi-duration:180s] [&[data-row='1']]:[--testi-duration:210s] [&[data-row='2']]:[--testi-duration:195s] [@media(prefers-reduced-motion:_reduce)]:contents" data-row={r}>
          {/* Two copies of the row make the marquee loop seamless. */}
          {[0, 1].map((copy) => (
            <div class="testi__track flex gap-3 shrink-0 [animation:testi-drift_var(--testi-duration)_linear_infinite] [animation-play-state:paused] [.testi[data-seen]_&]:[animation-play-state:running] [.testi\_\_row[data-row='1']_&]:[animation-direction:reverse] [&[inert]]:select-none [.testi[data-seen]_.testi\_\_marquee:hover_&]:[animation-play-state:paused] [.testi[data-seen]_.testi\_\_marquee:focus-within_&]:[animation-play-state:paused] [@media(prefers-reduced-motion:_reduce)]:[animation:none] [@media(prefers-reduced-motion:_reduce)]:flex-wrap [@media(prefers-reduced-motion:_reduce)]:[&[aria-hidden='true']]:hidden" aria-hidden={copy === 1 ? "true" : undefined} inert={copy === 1 ? true : undefined}>
              {r === 1 ? (
                <a
                  class="testi__card testi__card--add flex flex-col gap-[0.55rem] w-75 [padding:0.85rem_1rem_0.95rem] border rounded-[10px] [color:var(--color-ink-2)] no-underline! [transition:border-color_0.15s_ease,_background_0.15s_ease] [border-style:dashed] border-rule-strong bg-transparent hover:[border-style:solid] hover:border-ink hover:bg-surface [@media(prefers-reduced-motion:_reduce)]:w-[calc(50%_-_6px)] max-[719.98px]:w-60"
                  href={composeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex={copy === 1 ? -1 : undefined}
                >
                  <span class="testi__who flex items-center gap-[0.5rem] min-w-0 [&_img]:w-6 [&_img]:h-6 [&_img]:rounded-[999px] [&_img]:shrink-0 [&_img]:[box-shadow:0_0_0_1px_var(--color-rule)]">
                    <span class="testi__add-mark inline-flex items-center justify-center w-6 h-6 rounded-[999px] border border-rule-strong font-mono text-[14px] leading-[1] [color:var(--color-ink-2)] shrink-0 [.testi\_\_card--add:hover_&]:border-ink [.testi\_\_card--add:hover_&]:text-ink" aria-hidden="true">+</span>
                    <span class="testi__name text-[13px] font-medium text-ink whitespace-nowrap overflow-hidden text-ellipsis">Add yours</span>
                    <span class="testi__handle font-mono text-[11px] [color:var(--color-ink-3)] whitespace-nowrap">on X</span>
                  </span>
                  <span class="testi__text text-[13.5px] leading-[1.5] [display:-webkit-box] [-webkit-line-clamp:4] [-webkit-box-orient:vertical] overflow-hidden max-[719.98px]:[-webkit-line-clamp:5]">
                    Using Executor? Post about it and tag @executorsh. We read every one.
                  </span>
                </a>
              ) : null}
              {row.map((testimonial) => <TestimonialCard testimonial={testimonial} layout="preview" />)}
            </div>
          ))}
        </div>
      ))
    }
  </div>
  <div class="pointer-events-none relative -mt-12 flex justify-center bg-linear-to-t from-surface via-surface/95 to-transparent pt-12 pb-1">
    <button class="group pointer-events-auto inline-flex min-h-11 cursor-pointer items-center gap-2.5 rounded-full border border-rule-strong bg-surface px-5 py-2.5 text-[13px] font-medium text-ink shadow-[0_2px_5px_#00000006,0_6px_20px_#00000006] transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-0.5 hover:border-ink-3 hover:shadow-[0_4px_12px_#0000000a,0_8px_24px_#00000008] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink motion-reduce:hover:translate-y-0" type="button" aria-haspopup="dialog" aria-controls="testimonials-dialog" data-testimonials-open>
      Read all {testimonials.length} testimonials
      <svg class="size-3.5 text-ink-3 transition-colors group-hover:text-ink" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M9.5 3H13v3.5M13 3 9 7M6.5 13H3V9.5M3 13l4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <dialog
    id="testimonials-dialog"
    aria-labelledby="testimonials-title"
    aria-describedby="testimonials-description"
    class="testi-dialog fixed inset-0 m-auto h-[min(860px,88dvh)] max-h-none w-[min(1120px,calc(100%_-_3rem))] max-w-none translate-y-4 scale-[0.98] overflow-hidden rounded-3xl border border-white/70 bg-surface-2 p-0 text-ink opacity-0 shadow-[0_24px_100px_#00000026] transition-[opacity,translate,scale,display,overlay] transition-discrete duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] open:translate-y-0 open:scale-100 open:opacity-100 starting:open:translate-y-4 starting:open:scale-[0.98] starting:open:opacity-0 backdrop:bg-black/20 backdrop:opacity-0 backdrop:backdrop-blur-sm backdrop:transition-[opacity,display,overlay] backdrop:transition-discrete backdrop:duration-300 open:backdrop:opacity-100 starting:open:backdrop:opacity-0 motion-reduce:transform-none motion-reduce:transition-none motion-reduce:backdrop:transition-none max-[639.98px]:h-[94dvh] max-[639.98px]:w-[calc(100%_-_1rem)] max-[639.98px]:rounded-2xl"
  >
    <div class="flex h-full flex-col">
      <header class="flex shrink-0 items-start justify-between gap-4 bg-surface px-8 pt-7 pb-6 max-[639.98px]:px-5 max-[639.98px]:py-5">
        <div>
          <h2 id="testimonials-title" class="text-[26px] font-semibold tracking-[-0.035em] max-[639.98px]:text-[23px]">Good company.</h2>
          <p id="testimonials-description" class="mt-1.5 text-[14px] text-ink-2">{testimonials.length} notes from people using Executor.</p>
        </div>
        <button type="button" class="flex size-10 shrink-0 cursor-pointer items-center justify-center rounded-full border border-rule bg-surface text-ink-3 transition-colors hover:bg-surface-2 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" aria-label="Close testimonials" data-testimonials-close autofocus>
          <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
        </button>
      </header>
      <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain border-t border-rule px-7 pt-6 pb-8 [scrollbar-width:thin] max-[639.98px]:px-4 max-[639.98px]:pt-4" data-testimonials-scroll>
        <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
          {testimonials.map((testimonial, index) => (
            <div class="mb-4 break-inside-avoid [.testi-dialog[open]_&]:animate-[testi-appear_500ms_cubic-bezier(0.16,1,0.3,1)_both] motion-reduce:animate-none!" style={{ animationDelay: `${Math.min(index, 8) * 30}ms` }}>
              <TestimonialCard testimonial={testimonial} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  // Start the drift only once the section has entered the viewport.
  for (const el of document.querySelectorAll<HTMLElement>("[data-testimonials]")) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        el.dataset.seen = "1";
        io.disconnect();
      },
      { threshold: 0.2 },
    );
    io.observe(el);
  }

  const dialog = document.querySelector<HTMLDialogElement>("#testimonials-dialog");
  const openButton = document.querySelector<HTMLButtonElement>("[data-testimonials-open]");
  const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-testimonials-close]");
  const scrollArea = dialog?.querySelector<HTMLElement>("[data-testimonials-scroll]");

  if (dialog && openButton && closeButton && scrollArea) {
    let previousOverflow = "";
    openButton.addEventListener("click", () => {
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = "hidden";
      dialog.showModal();
      scrollArea.scrollTop = 0;
    });
    closeButton.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = previousOverflow;
    });
  }
</script>
