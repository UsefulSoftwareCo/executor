---
// Footer fragment: "For humans / For agents".
//
// The HTML homepage is the humans side (active, current page); the agents side
// links to /index.md, the Markdown representation. Below it, a mono line lists
// every machine-readable surface so an agent scraping the footer finds them
// all in one place.
//
// Grayscale only, existing tokens. Styles live in
// src/styles/variants/agents.css, prefixed `.agents-`.
import "../../styles/variants/agents.css";

const MARKDOWN_PATHS = ["/index.md", "/setup-prompt.md", "/pricing.md", "/llms.txt"];
---

<div class="agents-footer">
  <div class="agents-toggle" aria-label="Choose your representation">
    <a class="agents-toggle__item is-active" href="/" aria-current="page">For humans</a>
    <a class="agents-toggle__item" href="/index.md">For agents</a>
  </div>

  <p class="agents-markdown">
    <span class="agents-markdown__label">Markdown:</span>
    {
      MARKDOWN_PATHS.map((path, i) => (
        <>
          {i > 0 && <span class="agents-markdown__sep" aria-hidden="true">·</span>}
          <a href={path}>{path}</a>
        </>
      ))
    }
  </p>
</div>
