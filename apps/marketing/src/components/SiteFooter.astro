---
// The site footer, at the bottom of the body column. Shared: RailFrame closes
// every marketing page with it, and the documentation registers it as Blume's
// `layout.Footer` slot, so both halves of the origin end the same way.
//
// The brand mark resolves against the build's base, so the docs build (mounted
// at /docs) serves its own copy instead of reaching for the marketing root.
const MARK = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon-192.png`;

const GH = "https://github.com/UsefulSoftwareCo/executor";
---

<footer class="border-t border-rule py-10">
  <div class="max-w-[1200px] mx-auto px-6 sm:px-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 min-[1024px]:[.page:has(>_.page\_\_rail)_.page\_\_body_[class*='max-w-']&]:ml-0 min-[1024px]:[.page:has(>_.page\_\_rail)_.page\_\_body_.hero-inner_&]:ml-0 min-[1024px]:[.page:has(>_.page\_\_rail)_.page\_\_body_.text-center_&]:ml-0">
    <div class="flex items-center gap-2.5">
      <img src={MARK} alt="" width="16" height="16" class="w-4 h-4 opacity-80" />
      <span class="text-[13px] font-medium text-ink-2">executor</span>
      <span class="text-[12px] text-ink-3 ml-2">© {new Date().getFullYear()}</span>
    </div>
    <div class="flex items-center gap-6 text-[13px] text-ink-2">
      <a href="/docs" class="hover:text-ink transition-colors">Docs</a>
      <a href="/blog" class="hover:text-ink transition-colors">Blog</a>
      <a href={GH} class="hover:text-ink transition-colors">GitHub</a>
      <a href="/privacy" class="hover:text-ink transition-colors">Privacy</a>
      <a href="/terms" class="hover:text-ink transition-colors">Terms</a>
    </div>
  </div>
</footer>
