---
import posthog from "../assets/logos/posthog.svg?url";
import github from "../assets/logos/github.svg?url";
---

<div class="doc__fig--wide @container mt-7 max-w-225 overflow-hidden rounded-[9px] border border-tone-90 bg-tone-99">
  <div class="grid divide-y divide-tone-91 @min-[600px]:grid-cols-3 @min-[600px]:divide-x @min-[600px]:divide-y-0">
    <div class="px-5 py-5 @min-[760px]:px-6">
      <div class="mb-3 flex h-5 items-center gap-2" aria-hidden="true">
        <img src={posthog} alt="" width="18" height="18" class="size-4.5 object-contain" />
        <img src={github} alt="" width="18" height="18" class="logo-mono size-4.5 object-contain" />
      </div>
      <h3 class="text-[14px] font-medium text-tone-27">An existing tool</h3>
      <p class="mt-1 text-[12px] leading-[1.6] text-tone-60">Bring an MCP or API you already use.</p>
    </div>
    <div class="px-5 py-5 @min-[760px]:px-6">
      <div class="mb-3 flex h-5 items-center font-mono text-[17px] text-glyph-md" aria-hidden="true">#</div>
      <h3 class="text-[14px] font-medium text-tone-27">A skill</h3>
      <p class="mt-1 text-[12px] leading-[1.6] text-tone-60">Teach your agents how you like things done.</p>
    </div>
    <div class="px-5 py-5 @min-[760px]:px-6">
      <div class="mb-3 flex h-5 items-center font-mono text-[15px] text-glyph-json" aria-hidden="true">{`{ }`}</div>
      <h3 class="text-[14px] font-medium text-tone-27">Something new</h3>
      <p class="mt-1 text-[12px] leading-[1.6] text-tone-60">Describe it. Your agent writes the code.</p>
    </div>
  </div>
</div>
