---
// The rail frame: sticky rail on the left, one centred frame, footer at the
// bottom of the body column. Everything inside <body>, and nothing of the
// document shell.
// Prerendered pages resolve the star count once at build time.
import RailB from "../components/variants/rail-b.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getStars, formatStars } from "../lib/github";

interface Props {
  current?: "home" | "pricing" | "blog" | "docs" | "apps";
  /** Content layouts keep the frame in the viewport; the page owns its scroll region. */
  scroll?: "page" | "content";
}
const { current = "home", scroll = "page" } = Astro.props;

const stars = await getStars();
---

<main class:list={[scroll === "content" && "h-dvh overflow-hidden"]} class="min-h-dvh relative antialiased bg-surface isolate">
  <div class:list={[scroll === "content" && "h-full flex flex-col"]} class="relative z-10 page min-[1024px]:[&:has(>_.page\_\_rail)]:grid min-[1024px]:[&:has(>_.page\_\_rail)]:grid-cols-[var(--site-rail-width)_minmax(0,_1fr)] min-[1024px]:[&:has(>_.page\_\_rail)]:items-start min-[1024px]:[&:has(>_.page\_\_rail)]:max-w-[var(--site-frame-width)] min-[1024px]:[&:has(>_.page\_\_rail)]:[margin-inline:auto]">
    <div class:list={[scroll === "content" && "shrink-0"]} class="page__rail page__rail--b min-[1024px]:sticky min-[1024px]:top-0 min-[1024px]:h-dvh min-[1024px]:[overflow:hidden_auto] min-[1024px]:border-r min-[1024px]:border-r-rule max-[1023.98px]:sticky max-[1023.98px]:top-0 max-[1023.98px]:z-30 max-[1023.98px]:bg-surface">
      <RailB stars={stars != null ? formatStars(stars) : null} current={current}>
        <slot name="sidebar" slot="secondary" />
      </RailB>
    </div>
    <div class:list={[scroll === "content" && "flex h-full min-h-0 flex-col overflow-hidden [&>footer]:shrink-0"]} class="page__body min-[1024px]:[.page:has(>_.page\_\_rail)_&]:min-w-0 min-[1024px]:[.page:has(>_.page\_\_rail)_&]:[padding-inline:var(--site-content-gutter)]">
      <slot />

      <SiteFooter />
    </div>
  </div>
</main>
