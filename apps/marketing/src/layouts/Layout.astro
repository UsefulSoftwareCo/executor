---
import '../styles/global.css'
import { tagline, introduction } from '../content/site-copy'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
}

const {
  title = `Executor — ${tagline}`,
  description = introduction,
  noindex = false
} = Astro.props

const ogImage = new URL('/og-image.png', Astro.site ?? Astro.url).toString()
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/'
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url).toString()
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    </script>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="antialiased">
    <slot />
    <script>
      import { siteVisitorCookie, siteVisitorDays } from "../content/site-visitor";
      const phKey = import.meta.env.PUBLIC_POSTHOG_KEY;
      if (phKey) {
        const phPath = import.meta.env.PUBLIC_POSTHOG_PATH;
        if (typeof phPath !== "string" || !/^\/api\/[a-f0-9]{16}$/.test(phPath)) throw new Error("PostHog proxy path is missing from this build");
        const posthogReady = import("posthog-js").then(({ default: posthog }) => {
          posthog.init(phKey, {
            defaults: "2025-05-24",
            before_send: (event) => {
              if (event) {
                try {
                  const body = new Blob([JSON.stringify(event)], { type: "application/json" });
                  if (!navigator.sendBeacon(`${phPath}/push`, body)) console.warn("Could not queue analytics event");
                } catch { console.warn("Could not encode analytics event"); }
              }
              return null;
            },
            api_host: `${window.location.origin}${phPath}`,
            ui_host: import.meta.env.PUBLIC_POSTHOG_HOST ?? "https://us.posthog.com",
            autocapture: false,
            capture_pageview: true,
            persistence: "localStorage",
            disable_session_recording: true,
            capture_exceptions: false,
            person_profiles: "identified_only",
            loaded: (client) => {
              client.register({ product_version: "v2", surface: "marketing",
                environment: import.meta.env.PUBLIC_EXECUTOR_ENVIRONMENT, release: import.meta.env.PUBLIC_EXECUTOR_RELEASE,
                executor_test: String(import.meta.env.PUBLIC_EXECUTOR_ENVIRONMENT).startsWith("test-") });
              const domain = import.meta.env.PUBLIC_EXECUTOR_COOKIE_DOMAIN;
              document.cookie = `${siteVisitorCookie}=${encodeURIComponent(client.get_distinct_id())}; Path=/; Max-Age=${siteVisitorDays * 86400}; SameSite=Lax${domain ? `; Domain=${domain}` : ""}${location.protocol === "https:" ? "; Secure" : ""}`;
            },
          });
          return posthog;
        });
        window.addEventListener("analytics:capture", (e) => {
          const detail = (
            e as CustomEvent<{
              event: string;
              properties?: Record<string, unknown>;
            }>
          ).detail;
          void posthogReady.then((posthog) => posthog.capture(detail.event, detail.properties));
        });
      }
    </script>
    <script>
      import { startPublicErrorReporting } from "../error-reporting";
      startPublicErrorReporting("marketing", { dsn: import.meta.env.PUBLIC_SENTRY_DSN, tunnel: import.meta.env.PUBLIC_SENTRY_TUNNEL, environment: import.meta.env.PUBLIC_EXECUTOR_ENVIRONMENT, release: import.meta.env.PUBLIC_EXECUTOR_RELEASE });
    </script>
  </body>
</html>
