---
import CodeBlock from "blume/components/content/CodeBlock.astro";
import { releaseCommandLanguage, releaseCommands, type ReleaseCommandProduct } from "../release-commands.ts";
interface Props { product: typeof ReleaseCommandProduct.Type }
const { product } = Astro.props;
const { description, command } = releaseCommands[product];
const lang = releaseCommandLanguage(product);
---
<p>{description}</p>
<CodeBlock code={command} lang={lang} title={lang === "powershell" ? "PowerShell" : "Bash"} />
