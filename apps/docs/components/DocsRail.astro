---
// Blume's `layout.Header` slot: the marketing rail.
//
// Blume's RootLayout still builds the page — the document, the article header,
// the code blocks, the "On this page" outline and the page actions are all
// Blume's. This replaces its top header alone, with the same rail the
// marketing site shows, so `/` and `/docs` read as one site.
//
// The rail is `rail-b.astro` itself, not a copy of it: a full-height column
// from 1024px and a bar below that. The documentation tree goes in the rail's
// secondary slot, and the same tree becomes a "Documentation" menu under the
// bar on small screens. styles.css positions the two and takes Blume's own
// navigation column out of the grid.
import type { Navigation } from "blume";
import Search from "blume/components/layout/Search.astro";
import type { UIStrings } from "blume/core/i18n-ui.ts";
import RailB from "../../marketing/src/components/variants/rail-b.astro";
import { getStars, formatStars } from "../../marketing/src/lib/github";
import DocsNav from "./DocsNav.astro";
import "../styles.css";

interface Props {
  navigation: Navigation;
  route: string;
  searchEnabled: boolean;
  searchLocale?: string;
  searchStrings?: UIStrings["search"];
  searchVersion?: string | null;
}

const { navigation, route, searchEnabled, searchLocale, searchStrings, searchVersion = null } =
  Astro.props;

// Prerendered, so the star count resolves once at build time — the same call
// the marketing rail makes, memoized in the module for the whole build.
const stars = await getStars();
---

<div class="docs-rail sticky top-0 z-40 bg-surface min-[1024px]:fixed min-[1024px]:inset-y-0 min-[1024px]:[inset-inline-start:max(0px,calc((100%_-_var(--site-frame-width))/2))] min-[1024px]:w-[var(--site-rail-width)] min-[1024px]:overflow-x-hidden min-[1024px]:overflow-y-auto min-[1024px]:border-r min-[1024px]:border-r-rule">
  <RailB current="docs" stars={stars != null ? formatStars(stars) : null}>
    <div class="docs-rail__secondary" slot="secondary">
      {
        searchEnabled && (
          <Search
            locale={searchLocale}
            navigation={navigation}
            strings={searchStrings}
            version={searchVersion}
          />
        )
      }
      <nav aria-label="Documentation" class="docs-nav docs-nav--desktop">
        <DocsNav currentRoute={route} items={navigation.sidebar} />
      </nav>
    </div>
  </RailB>

  <details class="docs-nav docs-nav--mobile">
    <summary>Documentation</summary>
    <nav aria-label="Documentation">
      <DocsNav currentRoute={route} items={navigation.sidebar} />
    </nav>
  </details>
</div>
