+// ─── Standalone executable lockdown ──────────────────────────────────────────
+/// Whether this process is a `bun build --compile` executable, i.e. the
+/// standalone module graph is embedded in the running image. `main` sets it
+/// once, before argv or the environment is interpreted. While it is set, Bun
+/// ignores the environment variables that would otherwise let another local
+/// process change what code runs inside the executable: `BUN_BE_BUN`,
+/// `BUN_INTERNAL_WEBVIEW_HOST`, `BUN_OPTIONS`, `BUN_INSPECT`,
+/// `BUN_INSPECT_CONNECT_TO`, `BUN_INSPECT_PRELOAD`, `BUN_JSC_*` and
+/// `NODE_PATH`, and the runtime transpiler cache is off.
+static IS_STANDALONE_EXECUTABLE: core::sync::atomic::AtomicBool =
+    core::sync::atomic::AtomicBool::new(false);
+
+/// Called once from `main`, before any other thread exists.
+pub fn set_is_standalone_executable(value: bool) {
+    IS_STANDALONE_EXECUTABLE.store(value, core::sync::atomic::Ordering::Relaxed);
+}
+
+#[inline]
+pub fn is_standalone_executable() -> bool {
+    IS_STANDALONE_EXECUTABLE.load(core::sync::atomic::Ordering::Relaxed)
+}
+
+/// C++ view of [`is_standalone_executable`] (read by `JSCInitialize`).
+#[unsafe(no_mangle)]
+extern "C" fn Bun__isStandaloneExecutable() -> bool {
+    is_standalone_executable()
+}
+
