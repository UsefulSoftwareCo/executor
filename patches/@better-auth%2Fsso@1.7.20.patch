+//#region lazy dependencies
+// SAML, XML and public-suffix parsing are large and only SSO endpoints and hooks use them.
+// Each request imports them itself; module instances are shared, pending promises are not.
+let XMLParser, XMLValidator, getHostname, DOMParser, saml, xmlParser;
+async function loadDependencies() {
+	if (saml !== undefined) return;
+	const [fastXmlParser, tldts, xmldom, samlify] = await Promise.all([
+		import("fast-xml-parser"),
+		import("tldts"),
+		import("@xmldom/xmldom"),
+		import("samlify")
+	]);
+	if (saml !== undefined) return;
+	({ XMLParser, XMLValidator } = fastXmlParser);
+	({ getHostname } = tldts);
+	({ DOMParser } = xmldom);
+	xmlParser = new XMLParser({
+		ignoreAttributes: false,
+		attributeNamePrefix: "@_",
+		removeNSPrefix: true,
+		processEntities: false
+	});
+	const samlifyModule = typeof samlify.SPMetadata === "function" && typeof samlify.setSchemaValidator === "function" ? samlify : samlify.default ?? samlify;
+	samlifyModule.setSchemaValidator({ async validate(xml) {
+		if (XMLValidator.validate(xml, { allowBooleanAttributes: true }) === true) return "SUCCESS_VALIDATE_XML";
+		throw "ERR_INVALID_XML";
+	} });
+	saml = samlifyModule;
+}
+const withDependencies = (create) => (...args) => {
+	const handler = args.pop();
+	return create(...args, async (ctx) => {
+		await loadDependencies();
+		return handler(ctx);
+	});
+};
+const createAuthEndpoint = withDependencies(createNativeAuthEndpoint);
+const createAuthMiddleware = withDependencies(createNativeAuthMiddleware);
