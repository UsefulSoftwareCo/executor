@@ -0,0 +1,129 @@
+import { statSync } from "node:fs";
+import { join } from "node:path";
+
+import { escape } from "html-escaper";
+import type { Nodes } from "mdast";
+import { fromMarkdown, type Handle } from "mdast-util-from-markdown";
+import { gfmFromMarkdown } from "mdast-util-gfm";
+import { gfm } from "micromark-extension-gfm";
+import { parse } from "node-html-parser";
+
+import {
+  isInternalPath,
+  normalizeBasePath,
+  normalizePath,
+  withBasePath,
+  withComposedBasePath,
+} from "../core/base-path.ts";
+import matter from "../core/frontmatter.ts";
+import type { BlumeProject } from "../core/project-graph.ts";
+
+const referenceOrigin = "https://docs.invalid";
+
+export const markdownLinkRebaser = ({ config, context, manifest }: BlumeProject) => {
+  const base = normalizeBasePath(config.deployment.base);
+  const routes = new Set([
+    ...manifest.routes.map(({ path }) => path),
+    ...config.redirects.map(({ from }) => withBasePath(config.basePath, from)),
+  ]);
+
+  const docsPath = (pathname: string) => {
+    const path = normalizePath(decodeURI(pathname));
+    const page = path.replace(/\.mdx?$/u, "");
+    const route = page === "/index" && page !== path ? "/" : page;
+    if (routes.has(withBasePath(config.basePath, route))) {
+      return withComposedBasePath(base, config.basePath, pathname);
+    }
+    if (statSync(join(context.root, "public", path), { throwIfNoEntry: false })?.isFile()) {
+      return withBasePath(base, pathname);
+    }
+    return pathname;
+  };
+
+  return (source: string, fullTextRoute?: string): string => {
+    const pagePath = withBasePath(base, fullTextRoute ?? "/");
+    const relativeBase = new URL(
+      fullTextRoute === "/" && base ? pagePath + "/" : pagePath,
+      referenceOrigin
+    );
+    const destination = (href: string) => {
+      const trimmed = href.trim();
+      if (!trimmed || trimmed.startsWith("//") || /^[a-z][a-z0-9+.-]*:/iu.test(trimmed)) {
+        return href;
+      }
+      const rootRelative = isInternalPath(trimmed);
+      if (!rootRelative && fullTextRoute === undefined) {
+        return href;
+      }
+      const url = new URL(trimmed, relativeBase);
+      if (url.origin !== relativeBase.origin) return href;
+      const pathname = rootRelative
+        ? docsPath(url.pathname)
+        : /^[?#]/u.test(trimmed)
+          ? pagePath
+          : url.pathname;
+      return pathname + url.href.slice(url.origin.length + url.pathname.length);
+    };
+
+    const { content } = matter(source);
+    const bodyOffset = source.length - content.length;
+    const splices: Array<{ start: number; end: number; text: string }> = [];
+    const rewriteDestination: Handle = function ({ start, end }) {
+      const node = this.stack.at(-1);
+      if (!node || !("url" in node)) return;
+      const target = destination(node.url);
+      if (target === node.url) return;
+      const offset = start.offset;
+      const stop = end.offset;
+      if (offset === undefined || stop === undefined) return;
+      const angled = content[offset] === "<";
+      splices.push({
+        start: offset + Number(angled),
+        end: stop - Number(angled),
+        text: target.replace(/[&()<>]/gu, "\\$&"),
+      });
+    };
+    const visit = (node: Nodes): void => {
+      if ("children" in node) node.children.forEach(visit);
+      if (node.type !== "html") return;
+      const offset = node.position?.start.offset;
+      if (offset === undefined) return;
+      const html = content.slice(offset, node.position?.end.offset);
+      for (const element of parse(html).querySelectorAll("[href], [src]")) {
+        const rawAttrs = element.rawAttrs;
+        for (const attr of ["href", "src"]) {
+          const href = element.getAttribute(attr);
+          if (href === undefined) continue;
+          const target = destination(href);
+          if (target !== href) element.setAttribute(attr, escape(target));
+        }
+        if (rawAttrs === element.rawAttrs) continue;
+        const start = element.range[0] + 2 + element.rawTagName.length;
+        splices.push({
+          start: offset + start,
+          end: offset + start + rawAttrs.length,
+          text: element.rawAttrs,
+        });
+      }
+    };
+    visit(
+      fromMarkdown(content, {
+        extensions: [gfm()],
+        mdastExtensions: [
+          gfmFromMarkdown(),
+          {
+            exit: {
+              definitionDestination: rewriteDestination,
+              resourceDestination: rewriteDestination,
+            },
+          },
+        ],
+      })
+    );
+
+    for (const { start, end, text } of splices.toSorted((a, b) => b.start - a.start)) {
+      source = source.slice(0, bodyOffset + start) + text + source.slice(bodyOffset + end);
+    }
+    return source;
+  };
+};
