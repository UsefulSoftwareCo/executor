--- a/dist/commonjs/validate.js
+++ b/dist/commonjs/validate.js
@@ -429,7 +429,7 @@ function validate(instance, schema, draft = '2019-09', lookup = (0, dereference_
         if (!stop && $patternProperties !== undefined) {
             const keywordLocation = `${schemaLocation}/patternProperties`;
             for (const pattern in $patternProperties) {
-                const regex = new RegExp(pattern, 'u');
+                const regex = schemaPattern(pattern);
                 const subSchema = $patternProperties[pattern];
                 for (const key in instance) {
                     if (!regex.test(key)) {
@@ -782,7 +782,7 @@ function validate(instance, schema, draft = '2019-09', lookup = (0, dereference_
                 error: `String is too long (${length} > ${$maxLength}).`
             });
         }
-        if ($pattern !== undefined && !new RegExp($pattern, 'u').test(instance)) {
+        if ($pattern !== undefined && !schemaPattern($pattern).test(instance)) {
             errors.push({
                 instanceLocation,
                 keyword: 'pattern',
@@ -803,3 +803,12 @@ function validate(instance, schema, draft = '2019-09', lookup = (0, dereference_
     }
     return { valid: errors.length === 0, errors };
 }
+
+// Preserve Unicode matching, while accepting legacy JavaScript patterns used by upstream APIs.
+function schemaPattern(pattern) {
+    try { return new RegExp(pattern, 'u'); }
+    catch (error) {
+        if (!(error instanceof SyntaxError)) throw error;
+        return new RegExp(pattern);
+    }
+}
