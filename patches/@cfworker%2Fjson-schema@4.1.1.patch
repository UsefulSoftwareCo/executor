diff --git a/dist/commonjs/validate.js b/dist/commonjs/validate.js
index 75a3d4d9986e7fbb049103d4c6a4a7b0465a3f22..bcea1a2836372ff59b8610565a4b9f7fe38213e7 100644
--- a/dist/commonjs/validate.js
+++ b/dist/commonjs/validate.js
@@ -50,7 +50,10 @@ function validate(instance, schema, draft = '2019-09', lookup = (0, dereference_
     if ($recursiveAnchor === true && recursiveAnchor === null) {
         recursiveAnchor = schema;
     }
-    if ($recursiveRef === '#') {
+    // Apply every recursive reference. A schema nested under a pointer refers to its own root by that
+    // pointer, which is also the target used when no recursive anchor is in scope. Only "#" was
+    // applied before, so any other value was silently skipped.
+    if ($recursiveRef !== undefined) {
         const refSchema = recursiveAnchor === null
             ? lookup[__absolute_recursive_ref__]
             : recursiveAnchor;
@@ -429,7 +432,7 @@ function validate(instance, schema, draft = '2019-09', lookup = (0, dereference_
         if (!stop && $patternProperties !== undefined) {
             const keywordLocation = `${schemaLocation}/patternProperties`;
             for (const pattern in $patternProperties) {
-                const regex = new RegExp(pattern, 'u');
+                const regex = schemaPattern(pattern);
                 const subSchema = $patternProperties[pattern];
                 for (const key in instance) {
                     if (!regex.test(key)) {
@@ -782,7 +785,7 @@ function validate(instance, schema, draft = '2019-09', lookup = (0, dereference_
                 error: `String is too long (${length} > ${$maxLength}).`
             });
         }
-        if ($pattern !== undefined && !new RegExp($pattern, 'u').test(instance)) {
+        if ($pattern !== undefined && !schemaPattern($pattern).test(instance)) {
             errors.push({
                 instanceLocation,
                 keyword: 'pattern',
@@ -803,3 +806,12 @@ function validate(instance, schema, draft = '2019-09', lookup = (0, dereference_
     }
     return { valid: errors.length === 0, errors };
 }
+
+// Preserve Unicode matching, while accepting legacy JavaScript patterns used by upstream APIs.
+function schemaPattern(pattern) {
+    try { return new RegExp(pattern, 'u'); }
+    catch (error) {
+        if (!(error instanceof SyntaxError)) throw error;
+        return new RegExp(pattern);
+    }
+}
