{
  "name": "fumadb-effect",
  "version": "0.1.0",
  "private": true,
  "description": "Effect-native unified schema, query, and migration layer for library authors. A port of fumadb to Effect v4 and Effect SQL.",
  "keywords": [
    "cockroachdb",
    "database",
    "effect",
    "effect-ts",
    "fumadb",
    "migration",
    "mssql",
    "mysql",
    "orm",
    "postgresql",
    "schema",
    "sql",
    "sqlite"
  ],
  "license": "MIT",
  "author": "Rhys Sullivan",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./query": "./src/query.ts",
    "./adapter": "./src/adapter.ts",
    "./migration": "./src/migration.ts",
    "./sql": "./src/sql.ts",
    "./cli": "./src/cli.ts",
    "./package.json": "./package.json",
    "./pglite": "./src/pglite.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.1",
    "@effect/sql-mssql": "4.0.1",
    "@effect/sql-mysql2": "4.0.1",
    "@effect/sql-pg": "4.0.1",
    "@effect/sql-pglite": "4.0.1",
    "@effect/sql-sqlite-node": "4.0.1"
  },
  "peerDependencies": {
    "@effect/sql-pglite": "4.0.1"
  },
  "peerDependenciesMeta": {
    "@effect/sql-pglite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
