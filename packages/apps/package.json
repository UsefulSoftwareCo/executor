{
  "name": "apps",
  "version": "0.0.1-beta.66",
  "private": true,
  "description": "TypeScript apps with typed tools, accounts, storage, and UI.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./framework-reference.json": "./dist/framework-reference.json",
    "./package.json": "./package.json",
    "./contracts": "./src/contracts/host.ts",
    "./host": "./src/host.ts",
    "./effect": "./src/effect.ts",
    "./operations/approval": "./src/approval.ts",
    "./client": "./src/client.ts",
    "./mcp": "./src/mcp.ts",
    "./mcp/stdio": "./src/mcp-stdio.ts",
    "./mcp/effect": "./src/implementation/mcp.ts",
    "./graphql": "./src/graphql.ts",
    "./openapi": "./src/openapi.ts",
    "./ui/contracts": "./src/contracts/ui.ts",
    "./ui/auth": "./src/ui-auth.ts",
    "./ui/serving": "./src/ui-serving.ts",
    "./ui/auth/contracts": "./src/contracts/ui-auth.ts",
    "./react": "./src/react.ts",
    "./storage/facet": "./src/facet.ts",
    "./skills": "./src/skills.ts",
    "./skills/effect": "./src/implementation/skill-files.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack": "bun run build && npm pack ./dist --pack-destination ./dist",
