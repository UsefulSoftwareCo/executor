  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@csstools/css-tokenizer": "4.0.2",
    "@executor-js/app-cache": "workspace:*",
    "@executor-js/app-data": "workspace:*",
    "@executor-js/telemetry": "workspace:*",
    "@executor-js/utils": "workspace:*",
    "@scalar/helpers": "0.14.0",
    "@scalar/openapi-upgrader": "0.3.1",
    "effect": "4.0.1",
    "js-yaml": "5.4.2",
    "openapi-server-url-templating": "1.3.0",
    "parse5": "8.0.0",
    "swagger-client": "3.38.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260729.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.0",
    "esbuild": "0.28.2",
    "graphql": "16.11.0",
    "react": "^19.2.0",
    "typescript-5": "npm:typescript@5.9.3"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "graphql": "^16.11.0",
    "react": "^19.2.0"
  },
