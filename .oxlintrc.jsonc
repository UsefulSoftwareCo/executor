{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "jsPlugins": ["./scripts/oxlint-plugin.ts"],
  "rules": {
    "typescript/no-explicit-any": "error",
    // Effect.gen bodies without a yield are valid Effect code.
    "require-yield": "off",
    "executor/exportable-schema-pattern": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@tanstack/react-router",
            "importNames": ["Navigate"],
            "message": "<Navigate> starts its navigation again on every render, so under a layout that re-renders on location changes it never finishes and freezes the tab. Throw redirect() from the route's beforeLoad, or navigate once from an effect.",
          },
        ],
      },
    ],
  },
  "overrides": [
    {
      // The live host protocol reaches these patterns, and its record is compared with every
      // released protocol's, flags included; see notes/apps-publishing.md.
      "files": [
        "packages/apps/src/contracts/protocols/**",
        "packages/apps/src/contracts/provider.ts",
        "packages/apps/src/contracts/failure.ts",
        "packages/apps/src/contracts/icons.ts",
        "packages/app-cache/src/contracts/cache.ts",
      ],
      "rules": { "executor/exportable-schema-pattern": "off" },
    },
    {
      // Workers and servers reuse one module instance across requests.
      "files": ["apps/**/src/**", "packages/*/src/**"],
      "rules": { "executor/no-module-level-mutable-state": "error" },
    },
    {
      // Product code: a synchronous write to stdout or stderr can hold the process open.
      "files": ["apps/**/src/**", "packages/*/src/**"],
      "rules": { "executor/no-sync-stdio-write": "error" },
    },
    {
      // Worker entry points: initialization runs once per isolate, for every request it serves.
      "files": ["apps/hosted/cloud/src/**"],
      "rules": { "executor/no-shared-wait-in-worker-initialization": "error" },
    },
    {
      // Exceptions kept here because a comment in these files changes the published apps
      // framework. openapi-source keeps an isolate-wide cache of content-addressed parts.
      "files": ["packages/apps/src/implementation/openapi-source.ts"],
      "rules": { "executor/no-module-level-mutable-state": "off" },
    },
    {
      // An app's callbacks, and methods of values it passes such as its cache, are the app's
      // time in tool-call accounting only when the framework waits on them through fromPromise.
      // The files are the framework and the workspace packages it bundles into the app isolate.
      // The SDK's only code in the isolate is generated strings: the bridge in worker-bridge.ts,
      // whose one entry into the app is apps/host's dispatch, and the network module in
      // app-network.ts, which waits only on the platform's fetch. The rest of the SDK runs
      // outside the isolate and reaches an app only by RPC.
      "files": [
        "packages/apps/src/**",
        "packages/app-cache/src/**",
        "packages/telemetry/src/**",
        "packages/utils/src/api-error.ts",
        "packages/utils/src/recorded-message.ts",
      ],
      "rules": { "executor/authored-code-through-adapter": "error" },
    },
    {
      // The adapter itself, and modules that run only in the browser, outside any invocation.
      "files": [
        "packages/apps/src/implementation/authoring.ts",
        "packages/apps/src/browser/**",
        "packages/apps/src/implementation/live.ts",
        "packages/apps/src/implementation/optimistic.ts",
        "packages/apps/src/implementation/ui-client.ts",
        "packages/telemetry/src/browser*.ts",
      ],
      "rules": { "executor/authored-code-through-adapter": "off" },
    },
    {
      // Code the self-host dashboard runs in the browser, which may be served over plain HTTP on
      // a LAN address. App UIs are published only on HTTPS or localhost, so the apps client is not
      // listed.
      "files": [
        "apps/hosted/web/src/**",
        "apps/hosted/self-host/web/src/**",
        "packages/ui/src/**",
        "packages/telemetry/src/browser*.ts",
      ],
      "rules": { "executor/no-secure-context-api": "error" },
    },
    {
      // The only browser code allowed to read crypto.randomUUID, crypto.subtle and
      // navigator.clipboard: the helpers that wrap them. Any feature detection for these APIs
      // belongs inside such a helper; add a new helper here rather than exempting a caller.
      "files": [
        "packages/ui/src/implementation/lib/clipboard.ts",
        "packages/utils/src/random-uuid.ts",
      ],
      "rules": { "executor/no-secure-context-api": "off" },
    },
    {
      // Authorization proofs are minted only where their check runs.
      "files": ["apps/hosted/server/src/**"],
      "rules": {
        "executor/no-proof-forgery": "error",
        "executor/account-middleware-through-helper": "error",
      },
    },
    {
      // The helper itself attaches the middleware.
      "files": ["apps/hosted/server/src/contracts/account-grants.ts"],
      "rules": { "executor/account-middleware-through-helper": "off" },
    },
    {
      "files": ["apps/hosted/server/src/implementation/proofs/**"],
      "rules": { "executor/no-proof-forgery": "off" },
    },
    {
      "files": ["e2e/**"],
      "rules": { "executor/no-manual-effect-runtime-in-tests": "error" },
    },
    {
      // The evidence viewer is a browser app, not a scenario.
      "files": ["e2e/viewer/**"],
      "rules": { "executor/no-manual-effect-runtime-in-tests": "off" },
    },
    {
      // Compile-only type checks declare functions and expressions that are never run.
      "files": ["**/*.types.tsx", "**/*.types.ts"],
      "rules": {
        "no-unused-vars": "off",
        "no-unused-expressions": "off",
      },
    },
  ],
  "ignorePatterns": [
    ".alchemy/",
    "**/.blume/",
    ".local/",
    ".reference/",
    ".wrangler/",
    "dist/",
    "node_modules/",
    "patches/",
    "bun.lock",
    "*.tsbuildinfo",
    "**/.generated/",
    "**/routeTree.gen.ts",
    "**/browser-scripts.gen.ts",
    "**/executor-intro.gen.ts",
  ],
}
