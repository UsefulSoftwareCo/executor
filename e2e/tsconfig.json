{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "src",
    "cloud",
    "scenarios",
    "selfhost",
    "selfhost-docker",
    "setup",
    "targets",
    "scripts",
    "viewer/src"
  ]
}
