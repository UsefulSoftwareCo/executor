{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // Errors fail the typecheck. Warnings are reported; suggestions stay in the editor.
        "includeSuggestionsInTsc": false,
        "ignoreEffectWarningsInTscExitCode": true,
        "diagnosticSeverity": {
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingLayerContext": "error",
          "leakingRequirements": "error",
          // Warning until author and Promise boundaries get typed errors: 313 and 21 sites.
          "anyUnknownInErrorContext": "warning",
          "unknownInEffectCatch": "warning",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "missingReturnYieldStar": "error",
          "globalFetchInEffect": "error",
          "globalConsoleInEffect": "error",
          // Warning until Effect code reads time through Clock/DateTime: 92 sites.
          "globalDateInEffect": "warning",
          // Warning until imports move behind platform services or edges: 247 sites, 214 in e2e.
          "nodeBuiltinImport": "warning",
          // The framework is built on Effect's unstable HTTP, SQL, CLI, AI and reactivity
          // modules by design. Upgrades are reviewed against the release notes instead.
          "unstableApiUsage": "off",
          "experimentalApiUsage": "off"
        }
      }
    ]
  },
  "exclude": [
    "apps/local/web",
    "apps/hosted/web",
    "apps/hosted/cloud/web",
    "apps/hosted/self-host/web",
    "apps/marketing",
    "apps/docs",
    "**/dist",
    "**/.blume"
  ],
  "include": ["packages", "apps", "playground", "scripts/oxlint-plugin.ts"]
}
